# Copy this file to `.env` (in the root directory) and fill in the values.
# The `.env` file is NOT uploaded to the repo.

# PostgreSQL database (create an empty database before deploying the API)
DB_DATABASE=FeedBack-Collector
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Key for signing JWTs (use a long, random value)
JWT_SECRET=

# Email (Brevo). Without BREVO_API_KEY or MAIL_FROM_EMAIL, the API will not send emails (it will only log a warning).
# BREVO_API_KEY=…
# MAIL_FROM_EMAIL must be a verified sender in Brevo (Senders & IP).
# MAIL_FROM_EMAIL=…
# MAIL_FROM_NAME=Feedback Collector
# APP_URL: Public URL of the frontend; if specified, the account approval email includes a login link.
# APP_URL=…

# Base URL of the backend for the Vite frontend (displayed to the browser).
VITE_API_URL=

# --- For deployment only (shared instance) ---
# If set, this is used instead of the DB_* variables above.
# DATABASE_URL=postgres://username:password@host:5432/database
# Set to true if your managed Postgres requires SSL (External Render, Neon, Supabase...)
# DB_SSL=false
# The port is usually assigned by the platform (PORT). Default is 3000.
# PORT=3000
